FROM ubuntu:24.04

WORKDIR /root/

RUN apt update
RUN apt install -y git libglu1-mesa libxt6t64 libvulkan1 libgl1 x11-common libgomp1 wget unzip python3.12

RUN wget -qO- https://astral.sh/uv/install.sh | sh
RUN git clone https://github.com/isaac-sim/IsaacLab.git --branch release/3.0.0

WORKDIR /root/IsaacLab

RUN bash -c "source /root/.local/bin/env && uv venv .venv && source .venv/bin/activate && uv pip install --upgrade pip && ./isaaclab.sh -i"